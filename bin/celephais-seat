#!/usr/bin/env bash
# Celephais Local Seat switcher. Run on the Proxmox host.
# Exactly one running Realm may own the RTX 2060 + USB keyboard/mouse.
set -euo pipefail

# Local Seat hardware. Verify with: lspci -nn | grep -i nvidia ; lsusb
SEAT_PCI=(0000:01:00.0 0000:01:00.1)   # GPU + HDMI/DP audio
SEAT_USB=(1532:02a2 046d:c52b)         # Razer Ornata V3 X, Logitech Unifying
# Core passes the approved devices as extra arguments to switch, taken from
# its own registry, where a serial number identifies a device properly. The
# list above is the fallback for running this by hand on a fresh host.

declare -A REALMS=( [work]=201 [personal]=202 [windows]=100 )

SHUTDOWN_TIMEOUT=${SHUTDOWN_TIMEOUT:-120}

die() { echo "celephais-seat: $*" >&2; exit 1; }

vm_status() { qm status "$1" | awk '{print $2}'; }

holds_seat() { qm config "$1" | grep -q '^hostpci0:'; }

# A parked Realm is stopped, but a live session is waiting in a state file.
is_parked() { qm config "$1" | grep -q '^vmstate:'; }

# Every topology change routes through these two, so the guard lives here and
# not in each caller. Proxmox restores a saved session into whatever hardware
# the config names at the time, and the session was saved against different
# hardware. Wake it first; wake_and_stop does that.
refuse_if_parked() {
  is_parked "$1" && die "VM $1 has a saved session. Changing its hardware now \
would restore that session into hardware it never had. Wake it first."
  return 0
}

# Put a parked Realm back on its feet and then down properly, so its hardware
# can be changed. The saved desktop is lost; that is the price of the change,
# and Core warns about it before asking for this.
wake_and_stop() {
  local vmid=$1 i
  is_parked "$vmid" || return 0
  echo "realm $vmid has a saved session; waking it to shut it down properly" >&2
  qm start "$vmid"
  for i in $(seq 60); do
    [ "$(vm_status "$vmid")" = running ] && break
    sleep 1
  done
  [ "$(vm_status "$vmid")" = running ] || die "VM $vmid did not resume; nothing was changed"
  sleep 10                      # let the desktop finish coming back before ACPI
  stop_realm "$vmid"
}

# Drop every passthrough key the VM actually has. VM must be stopped.
detach_seat() {
  local keys
  refuse_if_parked "$1"
  keys=$(qm config "$1" | grep -oE '^(hostpci|usb)[0-9]+' | paste -sd, - || true)
  [ -n "$keys" ] || return 0
  qm set "$1" -delete "$keys"
}

attach_seat() {
  local vmid=$1 i
  shift
  local usb=("$@")
  [ ${#usb[@]} -gt 0 ] || usb=("${SEAT_USB[@]}")
  refuse_if_parked "$vmid"
  for i in "${!SEAT_PCI[@]}"; do qm set "$vmid" "-hostpci$i" "${SEAT_PCI[$i]},pcie=1"; done
  for i in "${!usb[@]}";      do qm set "$vmid" "-usb$i"     "host=${usb[$i]}"; done
}

# Not the ACPI power button first: GNOME takes a block inhibitor on the power
# key, so logind never sees the press and `qm shutdown` waits for a guest that
# was never asked. The agent runs the shutdown inside, with no desktop in the
# way. A Realm without a working agent still gets the button.
stop_realm() {
  local i
  [ "$(vm_status "$1")" = running ] || return 0
  if qm guest cmd "$1" shutdown >/dev/null 2>&1; then
    for i in $(seq "$SHUTDOWN_TIMEOUT"); do
      [ "$(vm_status "$1")" = stopped ] && break
      sleep 1
    done
  else
    qm shutdown "$1" --timeout "$SHUTDOWN_TIMEOUT" || true
  fi
  [ "$(vm_status "$1")" = stopped ] || die "VM $1 did not stop in ${SHUTDOWN_TIMEOUT}s. Stop it by hand."
}

cmd_status() {
  local name vmid
  for name in $(echo "${!REALMS[@]}" | tr ' ' '\n' | sort); do
    vmid=${REALMS[$name]}
    printf '%-10s vm %-5s %-9s seat:%s\n' "$name" "$vmid" "$(vm_status "$vmid")" \
      "$(holds_seat "$vmid" && echo yes || echo no)"
  done
}

# Make a stopped Realm headless: no GPU, no Local Seat USB. Powering a Realm
# and giving it the Local Seat are separate operations, so start must never
# inherit a seat left in the config by the previous session.
cmd_release() {
  local target=${1:-} vmid
  [ -n "$target" ] || die "usage: celephais-seat release <realm>"
  vmid=${REALMS[$target]:-}
  [ -n "$vmid" ] || die "unknown realm '$target'. known: ${!REALMS[*]}"
  [ "$(vm_status "$vmid")" = stopped ] || die "realm '$target' is running; stop it first"
  detach_seat "$vmid"
  echo "Local Seat released from $target (VM $vmid)"
}

cmd_switch() {
  local target=${1:-} vmid name other
  [ -n "$target" ] || die "usage: celephais-seat switch <realm> [vid:pid ...]"
  shift
  vmid=${REALMS[$target]:-}
  [ -n "$vmid" ] || die "unknown realm '$target'. known: ${!REALMS[*]}"

  # Release the seat from any other Realm. A headless Realm keeps running.
  for name in "${!REALMS[@]}"; do
    [ "$name" = "$target" ] && continue
    other=${REALMS[$name]}
    if holds_seat "$other"; then stop_realm "$other"; wake_and_stop "$other"; detach_seat "$other"; fi
  done

  if [ "$(vm_status "$vmid")" = running ]; then
    if holds_seat "$vmid"; then echo "realm '$target' already owns the Local Seat"; return 0; fi
    stop_realm "$vmid"   # PCI passthrough cannot be added to a running VM
  fi

  wake_and_stop "$vmid"
  detach_seat "$vmid"
  attach_seat "$vmid" "$@"
  qm start "$vmid"
  echo "Local Seat -> $target (VM $vmid)"
}

case "${1:-status}" in
  status) cmd_status ;;
  switch) shift; cmd_switch "$@" ;;
  release) shift; cmd_release "${1:-}" ;;
  *) die "usage: celephais-seat [status | switch <realm> | release <realm>]" ;;
esac
